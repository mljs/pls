{
  "name": "ml-pls",
  "version": "4.3.2",
  "description": "Partial least squares library",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "bench": "node ./benchmark/transpose.cjs",
    "build": "npm run tsc && cheminfo-build --entry lib/index.js --root PLS",
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "eslint": "eslint src",
    "eslint-fix": "eslint src --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check src",
    "prettier-write": "prettier --write src",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mljs/pls.git"
  },
  "keywords": [
    "partial",
    "least",
    "squares",
    "projection",
    "latent",
    "structures",
    "machine",
    "learning"
  ],
  "author": "Jefferson Hernández",
  "contributors": [
    "Julien Wist"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mljs/pls/issues"
  },
  "homepage": "https://github.com/mljs/pls",
  "dependencies": {
    "is-any-array": "^3.0.0",
    "ml-confusion-matrix": "^2.0.0",
    "ml-cross-validation": "^1.3.0",
    "ml-matrix": "^6.12.2",
    "ml-roc-multiclass": "^0.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.1.8",
    "benchmark": "^2.1.4",
    "cheminfo-build": "^1.3.2",
    "eslint": "^9.39.4",
    "eslint-config-cheminfo": "^18.0.0",
    "jest-matcher-deep-close-to": "^3.0.2",
    "ml-dataset-iris": "^1.2.1",
    "ml-dataset-metadata": "^0.3.0",
    "ml-kernel": "^4.0.0",
    "papaparse": "^5.5.3",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
